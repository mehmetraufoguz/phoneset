+void SoftcamStream::showSlate(BYTE* data, long size)
+{
+    if (!m_slate)
+    {
+        m_slate.reset(new Slate(m_width, m_height));
+    }
+    m_slate->render(data, (std::size_t)size, m_slate_frame);
+    m_slate_frame++;
+
+    // Pace the slate like a real camera: one picture per frame period.
+    float framerate = getParent()->framerate();
+    if (framerate <= 0.0f)
+    {
+        framerate = 60.0f;
+    }
+    framerate = (std::min)((std::max)(framerate, 1.0f), 1000.0f);
+    const auto interval = std::chrono::microseconds((long long)std::llround(1000000.0 / framerate));
+    const auto now = std::chrono::steady_clock::now();
+    if (!m_slate_paced || now > m_slate_due + 3 * interval)
+    {
+        // The first slate picture, or far behind (the machine was busy or asleep): start the beat again.
+        m_slate_due = now;
+        m_slate_paced = true;
+    }
+    std::this_thread::sleep_until(m_slate_due);
+    m_slate_due += interval;
+}
