<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used by release.sh: export the archive signed with a Developer ID Application certificate (distribution outside the
     App Store). The team id is the one in project.yml; it is public (it is in every signed app). -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>developer-id</string>
	<key>teamID</key>
	<string>JY83GWM55C</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>signingCertificate</key>
	<string>Developer ID Application</string>
</dict>
</plist>
