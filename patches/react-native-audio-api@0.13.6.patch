+/// The session's voice chat modes only set up routing and gain. The echo canceller is the
+/// voice-processing I/O unit, which an engine uses only once voice processing is switched on for its
+/// input node, so keep that switch in line with the session mode.
+/// Returns NO when the engine was running: voice processing changes the hardware formats, which live
+/// connections can't follow, so the engine is stopped and flagged to be rebuilt by its next start.
+- (BOOL)syncVoiceProcessing
+{
+  AVAudioSessionMode mode = [AVAudioSession sharedInstance].mode;
+  BOOL wanted = [mode isEqualToString:AVAudioSessionModeVoiceChat] ||
+      [mode isEqualToString:AVAudioSessionModeVideoChat];
+  AVAudioInputNode *engineInputNode = self.audioEngine.inputNode;
+
+  NSLog(
+      @"[AudioEngine] voice processing: wanted=%d current=%d engineRunning=%d mode=%@",
+      wanted,
+      engineInputNode.isVoiceProcessingEnabled,
+      [self.audioEngine isRunning],
+      mode);
+
+  if (engineInputNode.isVoiceProcessingEnabled == wanted) {
+    return YES;
+  }
+
+  if ([self.audioEngine isRunning]) {
+    [self.audioEngine stop];
+    self.sessionDeactivationInvalidatedGraph = YES;
+    return NO;
+  }
+
+  NSError *error = nil;
+  _voiceProcessingToggledAt = [NSProcessInfo processInfo].systemUptime;
+  BOOL switched = [engineInputNode setVoiceProcessingEnabled:wanted error:&error];
+  _voiceProcessingToggledAt = [NSProcessInfo processInfo].systemUptime;
+  if (!switched) {
+    NSLog(
+        @"[AudioEngine] Couldn't %@ voice processing: %@",
+        wanted ? @"enable" : @"disable",
+        [error debugDescription]);
+  }
+  return YES;
+}
+
 - (BOOL)materializeInputNodeIfNeeded
 {
   if (self.inputRegistration == nil) {
@@ -219,6 +265,10 @@ - (BOOL)materializeInputNodeIfNeeded
     return NO;
   }
 
+  if (![self syncVoiceProcessing]) {
+    return NO;
+  }
+
   AVAudioFormat *inputFormat = [self currentInputConnectionFormat];
 
   if (inputFormat == nil) {
@@ -437,6 +487,7 @@ - (void)rebuildAudioEngineAndResumeIfNeeded
   }
 
   _isRebuildingAudioEngine = YES;
+  NSLog(@"[AudioEngine] rebuilding the engine (state=%ld)", (long)self.state);
 
   if ([self.audioEngine isRunning]) {
     [self.audioEngine stop];
@@ -568,9 +619,26 @@ - (void)stopIfPossible
   }
 }
 
+- (BOOL)isConfigurationChangeSelfInduced
+{
+  return [NSProcessInfo processInfo].systemUptime - _voiceProcessingToggledAt < 1.5;
+}
+
 - (void)restartAudioEngine
 {
   std::scoped_lock lock(_engineLock);
+
+  // A safety valve: whatever keeps asking for restarts, never rebuild the engine in a tight loop on
+  // the main thread (that froze the app).
+  NSTimeInterval now = [NSProcessInfo processInfo].systemUptime;
+  if (now - _restartWindowStart > 2.0) {
+    _restartWindowStart = now;
+    _restartCount = 0;
+  }
+  if (++_restartCount > 4) {
+    NSLog(@"[AudioEngine] too many engine restarts in a row, ignoring this one");
+    return;
+  }
   [self rebuildAudioEngineAndResumeIfNeeded];
 }
 
